{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git 看板",
  "version": "3.1.0",
  "identifier": "local.gitboard.app",
  "build": {
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Git 看板",
        "width": 1240,
        "height": 840,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/AppIcon.icns"]
  }
}
